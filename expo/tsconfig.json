{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": null,
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/constants/*": [
        "./constants/*"
      ],
      "@/contexts/*": [
        "./contexts/*"
      ],
      "@/mocks/*": [
        "./mocks/*"
      ],
      "@/utils/*": [
        "./utils/*"
      ],
      "@/types/*": [
        "./types/*"
      ],
      "@/theme/*": [
        "./theme/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/config/*": [
        "./config/*"
      ],
      "@/graphql/*": [
        "./graphql/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}